{
  "name": "@frank/veniron-theme",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Piel «Agentic OS» + orbe de estado flotante. Sin panel propio: Frank prefiere Mission Control.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
